<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.therian.oc.aaabb.ui.SettingsActivity">

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_15"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnLang"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="320:56"
            android:background="@drawable/fr_setting"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16">

            <ImageView
                android:id="@+id/idLang"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:visibility="visible"
                app:layout_constraintVertical_bias="0.40789473684"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.39285714285"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="@dimen/dp_16"
                android:src="@drawable/ic_lang_set"
                 />

            <TextView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:gravity="start"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintHeight_percent="0.41071428571"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4054054054"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/idLang"
                android:includeFontPadding="false"
                android:text="@string/language"
                android:textColor="@color/app2"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeMaxTextSize="@dimen/sp_40"
                android:autoSizeMinTextSize="@dimen/sp_12"
                 />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/btnRate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_16"
            android:background="@drawable/bg_setting_item_v2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/btnLang"
            android:paddingHorizontal="@dimen/dp_16">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:src="@drawable/ic_rate_set"
                android:visibility="gone"
                android:tint="@color/figma_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:text="@string/rate_us"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnShareApp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_16"
            android:background="@drawable/bg_setting_item_v2"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/btnRate"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:layout_gravity="center"

                android:text="@string/share_app"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnPolicy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@id/btnShareApp"
            android:background="@drawable/bg_setting_item_v2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16">



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:text="@string/privacy_policy"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
