<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.character.ocmaker.creator.ui.SettingsActivity">

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_15"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnLang"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/fr_setting"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintDimensionRatio="320:56"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/idLang"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_16"
                android:contentDescription="@null"
                android:src="@drawable/ic_lang_set"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.39285714285"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.40789473684" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_16"
                android:autoSizeMaxTextSize="@dimen/sp_40"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeStepGranularity="@dimen/sp_0_5"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:text="@string/language"
                android:textColor="@color/app2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.40"
                app:layout_constraintStart_toEndOf="@id/idLang"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4054054054" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnRate"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/fr_setting"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintDimensionRatio="320:56"
            app:layout_constraintTop_toBottomOf="@id/btnLang">

            <ImageView
                android:id="@+id/idRate"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_16"
                android:contentDescription="@null"
                android:src="@drawable/ic_rate_set"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.39285714285"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.40789473684" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_16"
                android:autoSizeMaxTextSize="@dimen/sp_40"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeStepGranularity="@dimen/sp_0_5"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:text="@string/rate_us"
                android:textColor="@color/app2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.40"
                app:layout_constraintStart_toEndOf="@id/idRate"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4054054054" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnShareApp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/fr_setting"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintDimensionRatio="320:56"
            app:layout_constraintTop_toBottomOf="@id/btnRate">

            <ImageView
                android:id="@+id/idShare"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_16"
                android:contentDescription="@null"
                android:src="@drawable/ic_share_set"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.39285714285"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.40789473684" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_16"
                android:autoSizeMaxTextSize="@dimen/sp_40"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeStepGranularity="@dimen/sp_0_5"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:text="@string/share_app"
                android:textColor="@color/app2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.40"
                app:layout_constraintStart_toEndOf="@id/idShare"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4054054054" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnPolicy"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/fr_setting"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintDimensionRatio="320:56"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnShareApp">


            <ImageView
                android:id="@+id/idPrivacy"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_16"
                android:contentDescription="@null"
                android:src="@drawable/ic_policy_set"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.39285714285"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.40789473684" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_16"
                android:autoSizeMaxTextSize="@dimen/sp_40"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeStepGranularity="@dimen/sp_0_5"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:text="@string/privacy_policy"
                android:textColor="@color/app2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.40"
                app:layout_constraintStart_toEndOf="@id/idPrivacy"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4054054054" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
