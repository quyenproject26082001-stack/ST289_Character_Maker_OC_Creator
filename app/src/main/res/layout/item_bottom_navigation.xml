<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="@dimen/dp_48"
    android:layout_height="@dimen/dp_48"
    android:clipChildren="false"
    android:layout_gravity="center_vertical"
    android:clipToPadding="false">

    <!--    cvContent-->
    <FrameLayout
        android:id="@+id/cvContent"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:clipChildren="true"
        android:clipToPadding="true"
        tools:background="@drawable/bg_bottom_nav_selected"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">


        <!--            imvImage-->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="0dp"
            android:scaleX="0.85"
            android:scaleY="0.85"
            app:strokeColor="@color/transparent">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/sflShimmer"
                style="@style/ImageLoadingShimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imvImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/dp_0"
                    android:src="@color/image_shimmer_base"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <ImageView
                android:id="@+id/imvImageBG"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dp_0"
                android:scaleType="centerCrop" />
            <!--            imvImage-->
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
