<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">





        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="292:304"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:background="@drawable/bg_dialog_1"
            >



                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/single_marquee"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:fontFamily="@font/berlin_sans_fb_demi_bold"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/dp_3"
                    android:layout_marginHorizontal="@dimen/dp_30"
                    android:text="@string/choose_color"
                    app:layout_constraintHeight_percent="0.08881578947"
                    android:autoSizeMinTextSize="@dimen/sp_14"
                    android:autoSizeMaxTextSize="@dimen/sp_40"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="@dimen/sp_0_5"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_24"
                    app:layout_constraintVertical_bias="0.07220216606"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>




            <ir.kotlin.kavehcolorpicker.KavehColorPicker
                android:id="@+id/colorPickerView"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_200"
                android:layout_marginHorizontal="@dimen/dp_15"
                app:layout_constraintBottom_toBottomOf="parent"
                app:sliderStrokeSize="@dimen/dp_4"
                app:layout_constraintVertical_bias=".34"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_22"
                android:layout_marginTop="@dimen/dp_0"
                android:layout_marginBottom="@dimen/dp_30"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/colorPickerView"
                app:layout_constraintBottom_toBottomOf="parent">

                <ir.kotlin.kavehcolorpicker.KavehHueSlider
                    android:id="@+id/hueSlider"
                    app:layout_constraintTop_toTopOf="parent"
                    app:sliderStrokeSize="@dimen/dp_4"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_width="@dimen/dp_0"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_height="@dimen/dp_37" />


                <!--                btnDone-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnDone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_gravity="end"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/dp_10"
                    app:layout_constraintDimensionRatio="120:36"
                    android:background="@drawable/ic_no_dialog"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnClose"
                    app:layout_constraintTop_toBottomOf="@id/hueSlider"
                    >
                    <TextView
                        android:id="@+id/btnDoneText"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/berlin_sans_fb_demi_bold"
                        android:gravity="center"
                        android:text="@string/done"
                        style="@style/single_marquee"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textColor="@color/white"
                        app:layout_constraintHeight_percent="0.5"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="@dimen/sp_0_5"
                        android:autoSizeMaxTextSize="@dimen/sp_28"
                        android:autoSizeMinTextSize="@dimen/sp_14" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <!--                btnDone-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnClose"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginEnd="@dimen/dp_4"
                    android:layout_gravity="end"
                    android:layout_marginStart="@dimen/dp_10"
                    app:layout_constraintDimensionRatio="120:36"
                    android:layout_marginTop="@dimen/dp_10"
                    android:background="@drawable/ic_yes_dialog"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnDone"
                    app:layout_constraintTop_toBottomOf="@id/hueSlider"
                    >
                    <TextView
                        android:id="@+id/btnCancelText"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/berlin_sans_fb_demi_bold"
                        android:gravity="center"
                        android:text="@string/cancel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        style="@style/single_marquee"
                        android:textColor="@color/app2"
                        app:layout_constraintHeight_percent="0.5"
                        android:autoSizeTextType="uniform"
                       android:autoSizeStepGranularity="@dimen/sp_0_5"
                        android:autoSizeMaxTextSize="@dimen/sp_28"
                        android:autoSizeMinTextSize="@dimen/sp_14"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <RelativeLayout
                    android:id="@+id/btnStringColor"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_40"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/dp_6"
                    android:visibility="gone"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/btnDone"
                    app:layout_constraintBottom_toBottomOf="@id/btnDone"
                    app:layout_constraintEnd_toStartOf="@id/btnDone"
                    android:background="@drawable/bg_string_color">

                    <TextView
                        android:id="@+id/tvColorString"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/berlin_sans_fb_demi_bold"
                        android:gravity="center"
                        android:text="#FFFFFF"
                        android:layout_marginStart="@dimen/dp_12"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_20" />
                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
