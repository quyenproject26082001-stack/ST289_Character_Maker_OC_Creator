<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_22">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnlShareButtons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--            btnWhatsapp-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnCreation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/GLCenter1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_0"
            app:layout_constraintDimensionRatio="H,156:44"
            android:background="@drawable/bg_btn_bottom"
            tools:ignore="NotSibling">

            <TextView
                android:id="@+id/tvCreation"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintVertical_bias=".4"
                app:layout_constraintHeight_percent="0.45454545454"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
android:text="@string/my_creation"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:textColor="@color/white"
                android:autoSizeStepGranularity="@dimen/sp_0_5"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeMaxTextSize="@dimen/dp_30"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--            btnWhatsapp-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnDownload"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,156:44"

            app:layout_constraintStart_toStartOf="@id/GLCenter1"
app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_marginEnd="@dimen/dp_20"

            android:background="@drawable/bg_btn_bottom"
            tools:ignore="NotSibling">

            <TextView
                android:id="@+id/tvDownload"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintVertical_bias=".4"
                app:layout_constraintHeight_percent="0.45454545454"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="@string/download"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:textColor="@color/white"
                android:autoSizeStepGranularity="@dimen/sp_0_5"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeMaxTextSize="@dimen/dp_30"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/GLCenter1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLCenter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnFBShare"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_44"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_4"
        android:visibility="gone"
        android:background="@drawable/frame_facebook"
        app:layout_constraintEnd_toEndOf="@+id/GLCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lnlShareButtons">

        <ImageView
            android:id="@+id/icFb"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_10"
            android:scaleType="fitXY"
            android:src="@drawable/ic_fb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvFB"
            style="@style/single_marquee"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:fontFamily="@font/berlin_sans_fb_demi_bold"
            android:gravity="center"
            android:includeFontPadding="true"
            android:text="@string/facebook_share"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/icFb"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.character.ocmaker.creator.core.custom.layout.InstagramGradientLayout
        android:id="@+id/btnInstagram"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_44"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/frame_inst"
        android:layout_marginEnd="@dimen/dp_20"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/GLCenter"
        app:layout_constraintTop_toBottomOf="@id/lnlShareButtons">

        <ImageView
            android:id="@+id/icIst"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_10"
            android:scaleType="fitXY"
            android:src="@drawable/ic_inst"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvIns"
            style="@style/single_marquee"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:fontFamily="@font/berlin_sans_fb_demi_bold"
            android:gravity="center"
            android:includeFontPadding="true"
            android:text="@string/instagram_share"
            android:textColor="@color/white"

            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/icIst"
            app:layout_constraintTop_toTopOf="parent" />


    </com.character.ocmaker.creator.core.custom.layout.InstagramGradientLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
