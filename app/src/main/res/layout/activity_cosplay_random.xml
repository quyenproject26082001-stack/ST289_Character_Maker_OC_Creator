<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".ui.cosplay.CosplayRandomActivity">

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!--    cvImage-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cvImage"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_18"
        android:layout_marginBottom="@dimen/dp_16"
        android:background="@drawable/bg_avatar_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:layout_constraintVertical_bias="0.15">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/dp_2"
            app:cardBackgroundColor="#FFAE8C"
            app:cardCornerRadius="@dimen/dp_0"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.93333333333"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_2">


            <!--        sflShimmer-->
            <ImageView
                android:id="@+id/imvImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/guidRandom"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/guide_random"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>




    </androidx.constraintlayout.widget.ConstraintLayout>







    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_62"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvImage">
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/GLCenter1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />
        <!--            btnWhatsapp-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnGenerate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/GLCenter1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_0"
            app:layout_constraintDimensionRatio="H,156:44"
            android:background="@drawable/bg_btn_bottom"
            tools:ignore="NotSibling">

            <TextView
                android:id="@+id/tvRandom"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintVertical_bias=".4"
                app:layout_constraintHeight_percent="0.45454545454"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="@string/random"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:textColor="@color/white"
                android:autoSizeStepGranularity="@dimen/sp_0_5"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeMaxTextSize="@dimen/dp_30"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnCosPlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,156:44"

            app:layout_constraintStart_toStartOf="@id/GLCenter1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_marginEnd="@dimen/dp_20"

            android:background="@drawable/bg_btn_bottom"
            tools:ignore="NotSibling">

            <TextView
                android:id="@+id/tvCosplay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintVertical_bias=".4"
                app:layout_constraintHeight_percent="0.45454545454"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="@string/cosplay"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:textColor="@color/white"
                android:autoSizeStepGranularity="@dimen/sp_0_5"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeMaxTextSize="@dimen/dp_30"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Overlay chặn touch khi guide đang mở -->
    <View
        android:id="@+id/vOverlayGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- containerGuide ở cuối để có z-order cao nhất -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerGuide"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <TextView
            android:id="@+id/titleGuide"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:elevation="@dimen/dp_3"
            android:includeFontPadding="false"
            android:fontFamily="@font/berlin_sans_fb_demi_bold"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_10"
            android:text="@string/instruction"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_24"
            app:layout_constraintTop_toTopOf="@id/bg_frame1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bg_frame1"
            android:layout_width="@dimen/dp_328"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="@dimen/dp_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                app:strokeColor="@color/figma_primary"
                android:background="@drawable/bg_dialog_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/bg_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:fontFamily="@font/berlin_sans_fb_demi_bold"
                android:gravity="center"
                android:letterSpacing=".01"
                android:lineSpacingMultiplier="1.05"
                android:paddingHorizontal="@dimen/dp_25"
                android:paddingTop="@dimen/dp_50"
                android:paddingBottom="@dimen/dp_24"
                android:text="@string/guide_cosplay"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <TextView
            android:id="@+id/btnCloseGuide"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginTop="@dimen/dp_29"
            android:background="@drawable/ic_close"
            android:elevation="@dimen/dp_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bg_frame1" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
