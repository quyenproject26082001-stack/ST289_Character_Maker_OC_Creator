<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.permission.PermissionActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <ImageView
        android:id="@+id/imgPermission"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dp_95"
        android:layout_marginTop="@dimen/dp_14"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/img_permission"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/txtPermission"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_44"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_10"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgPermission">

        <com.character.ocmaker.creator.core.custom.text.DoubleStrokeTextView
            android:id="@+id/txtPer"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:fontFamily="@font/berlin_sans_fb_demi_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:outerStrokeColor="@color/transparent"
            app:outerStrokeWidth="@dimen/dp_0"
            tools:text="Allow Therian OC Maker to access photos, media and files on your device" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnStorage"
        android:layout_width="@dimen/dp_0"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/frame_permission"
        app:layout_constraintDimensionRatio="324:56"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtPermission">

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="@dimen/dp_24"
            android:autoSizeMaxTextSize="@dimen/sp_40"
            android:autoSizeMinTextSize="@dimen/sp_12"
            android:autoSizeStepGranularity="@dimen/sp_0_5"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:fontFamily="@font/berlin_sans_fb_demi_bold"
            android:includeFontPadding="false"
            android:text="@string/media"
            tools:text="aaaaaaaaaaa"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.44"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.44" />


        <ImageView
            android:id="@+id/swPermission"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_16"
            android:contentDescription="@string/notification"
            android:src="@drawable/bg_permission_switch_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="56:28"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.46666666666"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4375" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnNotification"
        android:layout_width="@dimen/dp_0"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/frame_permission"
        app:layout_constraintDimensionRatio="320:56"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtPermission">

        <TextView
            android:id="@+id/tvNotification"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_24"
            android:autoSizeMaxTextSize="@dimen/sp_40"
            android:autoSizeMinTextSize="@dimen/sp_12"
            android:autoSizeStepGranularity="@dimen/sp_0_5"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:fontFamily="@font/berlin_sans_fb_demi_bold"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/notification"
            tools:text="aaaaaaaaaaa"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.45"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.44" />

        <ImageView
            android:id="@+id/swNotification"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_16"
            android:contentDescription="@string/notification"
            android:src="@drawable/bg_permission_switch_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="56:28"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.46666666666"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4375" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvContinue"
        android:layout_width="@dimen/dp_148"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_51"
        android:fontFamily="@font/berlin_sans_fb_demi_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/continue_per"
        android:textColor="#FFEFCE"
        android:textSize="@dimen/sp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/permissionButtonsBottom" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/permissionButtonsBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btnStorage,btnNotification" />

    <FrameLayout
        android:id="@+id/native_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/ads_native_big_btn_bottom_shimmer" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
