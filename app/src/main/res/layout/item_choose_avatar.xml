<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:background="@color/gntAdGreen">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_margin="@dimen/dp_2"
        android:background="@drawable/bg_avatar_item"
        app:cardBackgroundColor="@color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/transparent">

        <!--            imvImage-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4"
                app:cardBackgroundColor="#FFAE8C"
                app:cardCornerRadius="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.875"
                app:layout_constraintDimensionRatio="1:1"
                app:strokeColor="@color/transparent"
                android:id="@+id/ctnImg">


                    <!--        sflShimmer-->
                    <ImageView
                        android:id="@+id/imvImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/im_home_1"
                       />
                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/sflShimmer"
                        style="@style/ImageLoadingShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:visibility="visible">
                        <!-- View nền để shimmer quét qua -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/image_shimmer_base" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>




    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
