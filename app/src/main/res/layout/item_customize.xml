<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_3_5"
    app:layout_constraintDimensionRatio="1:1">


    <!--        vFocus-->
    <View
        android:id="@+id/vFocus"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <FrameLayout
        android:id="@+id/cardLayerItem"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="@drawable/layer_slt">


        <!--                    imvImage-->
        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToOutline="true"
            android:scaleX="0.85"
            android:scaleY="0.85"
            android:scaleType="fitCenter"
            android:src="@color/dark" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sflShimmer"
            style="@style/ImageLoadingShimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/image_shimmer_base" />
        </com.facebook.shimmer.ShimmerFrameLayout>
        <!--            btnNone-->
        <ImageView
            android:id="@+id/btnNone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp_1"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:scaleY=".6"
            android:scaleX=".6"
            android:src="@drawable/ic_none"
            android:tint="#DC3C01"
            android:translationY="@dimen/dp_minus_2"
            android:visibility="gone"
            tools:visibility="visible" />

        <!--            btnRandom-->
        <ImageView
            android:id="@+id/btnRandom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp_1"
            android:clickable="true"
            android:focusable="true"
            android:scaleY=".6"
            android:scaleX=".6"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_random_layer"
            android:tint="#DC3C01"
            android:visibility="gone"
            tools:visibility="visible" />


    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
